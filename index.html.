    const block=document.createElement('div');block.className='sb';
    block.innerHTML=`
      <div class="sb-hd" onclick="toggleChap('${k}',this)">
        <div class="sb-emo" style="background:${s.hex}18">${s.em}</div>
        <div style="flex:1"><div class="sb-nm">${s.name}</div><div style="font-size:.56rem;color:var(--mu)">${ld2}/${s.chapters.length} chapters started</div></div>
        <div class="sb-pct" style="color:${s.hex}">${pct}%</div>
        <div class="chev${isExp?' open':''}">▾</div>
      </div>
      <div class="sb-trk"><div class="sb-fil" style="width:${pct}%;background:${s.hex}"></div></div>
      <div class="sb-sub"><span>${getDone(k)}/${s.total} lecs</span><span style="color:${s.hex}">${pct}% steps done</span></div>
      <div class="ch-list${isExp?'':' collapsed'}" id="chl-${k}">
        ${s.chapters.map((ch,i)=>chRowHtml(k,i,ch,s)).join('')}
      </div>`;
    list.appendChild(block);
  });
}

function chRowHtml(k,i,ch,s){
  const steps=getSteps(k,i);
  const sr=getSR(k,i);
  const str=chStr[k]?.[i]||'none';
  const passCount=STEPS.filter(st=>steps[st.id]).length;
  const pass=Math.min(4,Math.floor(passCount/STEPS.length*4)+1);
  const hasNote=!!(notes[k+'_'+i]);

  const stepsHtml=STEPS.map(st=>{
    const lbl=st.id==='mr'?s.mr:st.l;
    const on=!!steps[st.id];
    return `<div class="step" onclick="tglStep('${k}',${i},'${st.id}')">
      <div class="step-box ${st.c}${on?' on':''}">${lbl.slice(0,5)}</div>
    </div>`;
  }).join('');

  const srBadge=sr?`<span class="sr-b${sr==='due'?' due':''}">SR${sr==='due'?' DUE':''}</span>`:'';
  const dots=[1,2,3,4].map(p=>`<div class="pd${pass>=p?' p'+p:''}"></div>`).join('');

  return `<div class="ch-row" id="chr-${k}-${i}">
    <div class="ch-top">
      <span class="ch-num">${i+1}</span>
      <span class="ch-name">${ch}</span>
      ${srBadge}
      <button class="ch-notes-btn" onclick="openNoteModal('${k}',${i},'${ch.replace(/'/g,"\\'")}',event)">${hasNote?'📝':'+ Note'}</button>
      <span class="ch-str str-${str}" onclick="cycleStr('${k}',${i},event)">${str==='none'?'Rate':str.charAt(0).toUpperCase()+str.slice(1)}</span>
    </div>
    <div class="steps-row">${stepsHtml}</div>
    <div class="pass-row">${dots}<span class="pd-lbl">Pass ${pass}/4</span></div>
  </div>`;
}

function toggleChap(k,el){
  chapExp[k]=!chapExp[k];
  const p=document.getElementById('chl-'+k);
  const ch=el.querySelector('.chev');
  chapExp[k]?(p.classList.remove('collapsed'),ch?.classList.add('open')):(p.classList.add('collapsed'),ch?.classList.remove('open'));
}

function tglStep(k,i,sid){
  if(!chSt[k])chSt[k]={};if(!chSt[k][i])chSt[k][i]={};
  const was=!!chSt[k][i][sid];chSt[k][i][sid]=!was;sv('ncs',chSt);
  if(sid==='lec'&&!was)scheduleSR(k,i);
  const row=document.getElementById(`chr-${k}-${i}`);
  if(row)row.outerHTML=chRowHtml(k,i,SUBS[k].chapters[i],SUBS[k]);
  showToast(was?'↩ Unmarked':'✓ Step done!');
}

function cycleStr(k,i,e){
  e.stopPropagation();
  const cy=['none','weak','med','strong'];
  const cur=chStr[k]?.[i]||'none';
  const nxt=cy[(cy.indexOf(cur)+1)%cy.length];
  if(!chStr[k])chStr[k]={};chStr[k][i]=nxt;sv('nstr',chStr);
  const row=document.getElementById(`chr-${k}-${i}`);
  if(row)row.outerHTML=chRowHtml(k,i,SUBS[k].chapters[i],SUBS[k]);
  showToast({none:'Unmarked',weak:'😟 Weak',med:'😐 Medium',strong:'💪 Strong'}[nxt]);
}

function openNoteModal(k,i,ch,e){
  e.stopPropagation();
  activeNoteKey=`${k}_${i}`;
  document.getElementById('notes-title').textContent=`📝 ${ch}`;
  document.getElementById('notes-area').value=notes[activeNoteKey]||'';
  openModal('notes-m');
}
function saveNote(){
  if(!activeNoteKey)return;
  notes[activeNoteKey]=document.getElementById('notes-area').value;
  sv('nnotes',notes);closeModal('notes-m');
  // refresh row
  const[k,i]=activeNoteKey.split('_');
  const row=document.getElementById(`chr-${k}-${i}`);
  if(row)row.outerHTML=chRowHtml(k,parseInt(i),SUBS[k].chapters[parseInt(i)],SUBS[k]);
  showToast('Note saved 💾');
}

