function renderNcert(){
  const list=document.getElementById('ncert-list');list.innerHTML='';
  Object.entries(SUBS).forEach(([k,s])=>{
    const total=s.chapters.length;
    const done=(ncert[k]||[]).filter(v=>v==='done').length;
    const pct=Math.round(done/total*100);
    const block=document.createElement('div');block.className='ncert-sub';
    block.innerHTML=`<div class="ns-hd">
      <span style="font-size:1.1rem">${s.em}</span>
      <div class="ns-nm">${s.name}</div>
      <div class="ns-pct" style="color:${s.hex}">${pct}%</div>
    </div>
    <div class="ns-bar"><div class="ns-fill" style="width:${pct}%;background:${s.hex}"></div></div>
    <div class="ncert-chapters">${s.chapters.map((ch,i)=>{
      const st=(ncert[k]||[])[i]||'';
      return `<div class="nc-row">
        <span class="nc-nm">${i+1}. ${ch}</span>
        <button class="nc-btn ${st}" onclick="cycleNcert('${k}',${i},this)">${st==='done'?'✓ Done':st==='nr'?'Reading':'Not Started'}</button>
      </div>`;
    }).join('')}</div>`;
    list.appendChild(block);
  });
}

function cycleNcert(k,i,btn){
  if(!ncert[k])ncert[k]=[];
  const cy=['','nr','done'];const cur=ncert[k][i]||'';
  const nxt=cy[(cy.indexOf(cur)+1)%cy.length];
  ncert[k][i]=nxt;sv('nncert',ncert);
  btn.className=`nc-btn ${nxt}`;
  btn.textContent=nxt==='done'?'✓ Done':nxt==='nr'?'Reading':'Not Started';
  showToast(nxt==='done'?'📖 NCERT Done ✓':nxt==='nr'?'📖 Reading...':'Unmarked');
  // update pct
  const total=SUBS[k].chapters.length;
  const done=(ncert[k]||[]).filter(v=>v==='done').length;
  const pct=Math.round(done/total*100);
  const blk=btn.closest('.ncert-sub');
  if(blk){blk.querySelector('.ns-pct').textContent=pct+'%';blk.querySelector('.ns-fill').style.width=pct+'%'}
}

