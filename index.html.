let calY,calM;
(()=>{const t=new Date();calY=t.getFullYear();calM=t.getMonth()})();
function renderCal(){
  const MN=['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('cmt').textContent=`${MN[calM]} ${calY}`;
  const grid=document.getElementById('cgrid');grid.innerHTML='';
  ['Su','Mo','Tu','We','Th','Fr','Sa'].forEach(d=>{const el=document.createElement('div');el.className='cdl';el.textContent=d;grid.appendChild(el)});
  const td=t0();const fd=new Date(calY,calM,1).getDay();const dim=new Date(calY,calM+1,0).getDate();
  for(let i=0;i<fd;i++){const el=document.createElement('div');el.className='cc oor';grid.appendChild(el)}
  for(let day=1;day<=dim;day++){
    const d=new Date(calY,calM,day);const isT=ds(d)===ds(td);
    const inRange=inR(d);const isS=isStudy(d);const isPast=d<td&&isS;
    const el=document.createElement('div');
    let cls='cc';
    if(isT)cls+=' tod';
    else if(isSun(d)&&inRange)cls+=' sun-c';
    else if(isOff(d))cls+=' off-c';
    else if(isPast)cls+=' dne-c';
    else if(isS)cls+=' study-c';
    else if(!inRange)cls+=' oor';
    let tag='',dot='';
    if(isSun(d)&&inRange)tag=`<div class="ctag" style="color:var(--am)">REV</div>`;
    else if(isOff(d))tag=`<div class="ctag" style="color:var(--rd)">OFF</div>`;
    else if(isPast)dot=`<div class="cdot" style="background:var(--gr)"></div>`;
    else if(isS)dot=`<div class="cdot" style="background:rgba(200,184,255,.35)"></div>`;
    el.className=cls;el.innerHTML=`<div class="cn">${day}</div>${tag}${dot}`;
    grid.appendChild(el);
  }
}
function prevM(){calM--;if(calM<0){calM=11;calY--}renderCal()}
function nextM(){calM++;if(calM>11){calM=0;calY++}renderCal()}
function renderPhases(){
