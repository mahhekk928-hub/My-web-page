let chapExp={};
let activeNoteKey=null;

function renderChapters(){
  const list=document.getElementById('chap-list');list.innerHTML='';
  Object.entries(SUBS).forEach(([k,s])=>{
    const pct=getChPct(k),ld2=getChLecDone(k);
