function renderWeekly2(){
  const c=document.getElementById('plan-w');c.innerHTML='';
  const MN=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const today=t0();
  const ws=new Date(today);const day=ws.getDay();ws.setDate(ws.getDate()-(day===0?6:day-1));
  const rotN=['PHY+BOT+PC','PHY+ZOO+OC','PHY+BOT+IC+ZOO'];
  const DN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  for(let w=0;w<6;w++){
    const wst=new Date(ws);wst.setDate(wst.getDate()+w*7);
    const wed=new Date(wst);wed.setDate(wed.getDate()+6);
    const isCur=today>=wst&&today<=wed;
    let sdays=0;let d=new Date(wst);while(d<=wed){if(isStudy(d))sdays++;d.setDate(d.getDate()+1)}
    const days=[];for(let di=0;di<7;di++){
      const dd=new Date(wst);dd.setDate(dd.getDate()+di);if(dd>END)break;
      const isT=ds(dd)===ds(today);const ri=isStudy(dd)?((Math.floor((dd-START)/86400000))%3+3)%3:-1;
      days.push(`<div style="display:flex;align-items:center;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--b1);font-size:.64rem;${isT?'color:var(--ac);font-weight:700':''}">
        <span>${DN[dd.getDay()]} ${dd.getDate()}${isT?' ·':''}</span>
        <span style="color:${isSun(dd)?'var(--am)':isOff(dd)?'var(--rd)':isT?'var(--ac)':'var(--mu)'}">${isSun(dd)?'Revision 🔄':isOff(dd)?'Break 💤':ri>=0?rotN[ri]:'—'}</span>
      </div>`);
    }
    const card=document.createElement('div');card.className='mc';
    card.innerHTML=`<div class="mc-hd" onclick="this.nextElementSibling.classList.toggle('open')">
      <div><div class="mc-nm"${isCur?' style="color:var(--ac)"':''}>${wst.getDate()} ${MN[wst.getMonth()]} – ${wed.getDate()} ${MN[wed.getMonth()]}${isCur?' ← This Week':''}</div>
      <div class="mc-meta">${sdays} study days</div></div><span style="color:var(--mu);font-size:.76rem">▾</span>
    </div>
    <div class="mc-body${isCur?' open':''}">
      ${days.join('')}
      <div style="margin-top:8px;background:var(--fa);border-radius:7px;padding:7px;font-size:.6rem;color:var(--mu)">Target: ~${sdays*4} lectures · Sunday = revision only</div>
    </div>`;
    c.appendChild(card);
  }
}

