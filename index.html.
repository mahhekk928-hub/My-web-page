      <div style="flex:1">
        <div style="font-family:'Syne',sans-serif;font-weight:700;font-size:.84rem;${isPast?'color:var(--mu)':''}">${p.name}</div>
        <div style="font-size:.58rem;color:var(--mu);margin:2px 0">${p.s} → ${p.e}</div>
        <div style="font-size:.62rem;color:var(--mu)">${p.desc}</div>
      </div>
      ${isAct?`<span style="font-size:.5rem;padding:2px 9px;border-radius:100px;background:rgba(200,184,255,.1);color:var(--ac);font-weight:700;border:1px solid rgba(200,184,255,.18)">NOW</span>`:''}
      ${isPast?`<span style="font-size:.5rem;padding:2px 9px;border-radius:100px;background:var(--fa);color:var(--mu);font-weight:700">DONE</span>`:''}
    </div>`;
    list.appendChild(card);
  });
}

// ══════════════════════════════════════════
// POMODORO
// ══════════════════════════════════════════
let pM=25,pL='Focus 🎯',pRun=false,pLeft=1500,pTotal=1500,pTmr=null,pCnt=0;
const CIRC=2*Math.PI*75;
function setPomo(m,l,btn){
  if(pRun)return;pM=m;pL=l;pLeft=m*60;pTotal=m*60;
  document.querySelectorAll('.pt-btn').forEach(b=>b.classList.remove('on'));btn?.classList.add('on');
  updPomo();
}
function updPomo(){
  const m=Math.floor(pLeft/60),s=pLeft%60;
  document.getElementById('p-time').textContent=`${m<10?'0'+m:m}:${s<10?'0'+s:s}`;
  document.getElementById('p-lbl').textContent=pL.toUpperCase();
  const off=(CIRC*(1-pLeft/pTotal)).toFixed(1);
  const fl=document.getElementById('pr-fl');fl.style.strokeDashoffset=off;fl.style.stroke=pRun?'var(--gr)':'var(--ac)';
}
function togglePomo(){
  if(pRun){clearInterval(pTmr);pRun=false;document.getElementById('pb-go').textContent='▶ Resume'}
  else{pRun=true;document.getElementById('pb-go').textContent='⏸ Pause';
    pTmr=setInterval(()=>{pLeft--;updPomo();if(pLeft<=0){
      clearInterval(pTmr);pRun=false;pCnt++;
      const sub=document.getElementById('po-s').value;
      pomoSes.push({sub,m:pM,t:new Date().toLocaleTimeString('en',{hour:'2-digit',minute:'2-digit'})});
      sv('npses',pomoSes);document.getElementById('pb-go').textContent='▶ Start';
      document.getElementById('p-info').textContent=`Session ${pCnt+1} · ${pCnt} completed today`;
      renderPomoHist();showToast(`✅ ${pL} done! ${pCnt} sessions total`);pLeft=pTotal;updPomo();
    }},1000);}
}
function resetPomo(){clearInterval(pTmr);pRun=false;pLeft=pTotal;document.getElementById('pb-go').textContent='▶ Start';updPomo()}
function renderPomoHist(){
  const body=document.getElementById('ph-body');
  if(!pomoSes.length){body.innerHTML=`<div style="font-size:.66rem;color:var(--mu);text-align:center;padding:7px 0">No sessions yet 🍅</div>`;return}
  const ct={};pomoSes.forEach(s=>{ct[s.sub]=(ct[s.sub]||0)+s.m});
  body.innerHTML=Object.entries(ct).map(([k,m])=>`<div class="ph-row"><span>${SUBS[k].em} ${SUBS[k].name}</span><span style="color:var(--ac);font-weight:600">${(m/60).toFixed(1)}h</span></div>`).join('');
}

// ══════════════════════════════════════════
// STATS
// ══════════════════════════════════════════
function renderStats(){
  const td=getTD(),pct=getTotalPct(),sdl=sdLeft(),sde=sdElapsed();
  const totalCh=Object.values(SUBS).reduce((a,s)=>a+s.chapters.length,0);
  const doneCh=Object.keys(SUBS).reduce((a,k)=>a+getChLecDone(k),0);
  const perDay=Math.ceil((TOTAL-td)/Math.max(1,sdl));
  const data=[
    {l:'Lectures Done',v:td,s:`of ${TOTAL}`,c:'var(--ac)'},
    {l:'Overall',v:pct+'%',s:'syllabus',c:'var(--gr)'},
    {l:'Study Days',v:sde,s:`of ${sdTotal()}`,c:'var(--am)'},
    {l:'Days to NEET',v:dUntil(EXAM),s:'May 2027',c:'var(--rd)'},
    {l:'Needed/Day',v:perDay,s:'lectures',c:'var(--phy)'},
    {l:'Chapters',v:doneCh,s:`of ${totalCh}`,c:'var(--bot)'},
    {l:'MCQs Today',v:ld('nmcq_'+todayStr(),0),s:'solved',c:'var(--lm)'},
    {l:'Best Streak',v:(streak.best||0)+'🔥',s:`current: ${streak.cur||0}`,c:'var(--am)'},
  ];
  const grid=document.getElementById('sgrid');grid.innerHTML='';
  data.forEach(d=>{const el=document.createElement('div');el.className='stt';el.innerHTML=`<div class="stl">${d.l}</div><div class="stv" style="color:${d.c}">${d.v}</div><div class="sts">${d.s}</div>`;grid.appendChild(el)});
  const lb=document.getElementById('lbkd');lb.innerHTML='';
  Object.entries(SUBS).forEach(([k,s])=>{const p=getPct(k);const el=document.createElement('div');el.className='br';el.innerHTML=`<div class="bn" style="color:${s.hex}">${s.em} ${s.key.toUpperCase()}</div><div class="bb"><div class="bf" style="width:${p}%;background:${s.hex}"></div></div><div class="bv" style="color:${s.hex}">${getDone(k)}/${s.total}</div>`;lb.appendChild(el)});
  const cb=document.getElementById('cbkd');cb.innerHTML='';
  Object.entries(SUBS).forEach(([k,s])=>{const p=getChPct(k);const el=document.createElement('div');el.className='br';el.innerHTML=`<div class="bn" style="color:${s.hex}">${s.em} ${s.key.toUpperCase()}</div><div class="bb"><div class="bf" style="width:${p}%;background:${s.hex}"></div></div><div class="bv" style="color:${s.hex}">${getChPct(k)}%</div>`;cb.appendChild(el)});
  const milestones=[
    {i:'🚀',n:'First Step',d:'Log first lecture',u:td>=1},
    {i:'🔥',n:'7-Day Streak',d:'Stay consistent',u:(streak.best||0)>=7},
    {i:'⚡',n:'100 Lectures',d:'Getting started',u:td>=100},
    {i:'🧠',n:'25% Done',d:'Quarter complete',u:pct>=25},
    {i:'💪',n:'500 Lectures',d:'Halfway through lecs',u:td>=500},
    {i:'🌟',n:'50% Syllabus',d:'Halfway there!',u:pct>=50},
    {i:'🏆',n:'Phase 1 Done',d:'Foundation complete',u:pct>=35},
    {i:'👑',n:'720 Awaits',d:'75% syllabus done',u:pct>=75},
  ];
  const mg=document.getElementById('ms-grid');mg.innerHTML='';
  milestones.forEach(m=>{const el=document.createElement('div');el.className='ms '+(m.u?'unlocked':'locked');el.innerHTML=`<div class="mi">${m.i}</div><div class="mn">${m.n}</div><div class="md">${m.d}</div>`;mg.appendChild(el)});
}

// ══════════════════════════════════════════
// STREAK MODAL
// ══════════════════════════════════════════
function openModal(id){document.getElementById(id).classList.add('open');if(id==='streak-m')renderStreakBody()}
function closeModal(id){document.getElementById(id).classList.remove('open')}
function renderStreakBody(){
  document.getElementById('streak-body').innerHTML=`
    <div style="display:flex;flex-direction:column;gap:0">
      ${[['Current Streak',(streak.cur||0)+'🔥 days'],['Best Streak',(streak.best||0)+' days'],['Total Study Days',sdElapsed()+' days'],['Days Remaining',sdLeft()+' days'],['Last Active',streak.last||'Not started yet']].map(([l,v])=>`
        <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--b1);font-size:.72rem">
          <span style="color:var(--mu)">${l}</span>
          <span style="font-family:'Syne',sans-serif;font-weight:700;color:var(--am)">${v}</span>
        </div>`).join('')}
    </div>`;
}
function markDone(){updateStreak();renderHeader();showToast('🔥 Streak updated!');closeModal('streak-m')}

// LOG MODAL
function saveLog(){
  const k=document.getElementById('m-subj').value;const n=parseInt(document.getElementById('m-lecs').value)||0;
  if(n<=0){showToast('Enter lecture count ⚠️');return}
  prog[k]=(prog[k]||0)+n;sv('np',prog);closeModal('log-m');
  document.getElementById('m-lecs').value='';document.getElementById('m-note').value='';
  renderToday();updateStreak();renderHeader();showToast(`+${n} ${SUBS[k].name} saved! 🎯`);
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.mbg.open').forEach(m=>m.classList.remove('open'))});

// ══════════════════════════════════════════
// NOTIFICATIONS
// ══════════════════════════════════════════
function checkNotifPrompt(){
  if('Notification' in window && Notification.permission==='default'){
    document.getElementById('notif-banner').style.display='flex';
  }
}
async function requestNotif(){
  const perm=await Notification.requestPermission();
  document.getElementById('notif-banner').style.display='none';
  if(perm==='granted'){showToast('🔔 Reminders enabled!');scheduleReminder()}
}
function scheduleReminder(){
  // Set a daily reminder at 6 AM using SW if available
  if('serviceWorker' in navigator&&navigator.serviceWorker.controller){
    navigator.serviceWorker.controller.postMessage({type:'schedule_reminder'});
  }
}

// ══════════════════════════════════════════
// TOAST
// ══════════════════════════════════════════
let toastTmr;
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTmr);toastTmr=setTimeout(()=>t.classList.remove('show'),2500)}

// ══════════════════════════════════════════
// FAB
// ══════════════════════════════════════════
const fab=document.createElement('button');
fab.style.cssText='position:fixed;bottom:calc(78px + var(--sb));right:14px;width:44px;height:44px;border-radius:13px;background:var(--ac);border:none;color:#000;font-size:1.2rem;cursor:pointer;box-shadow:0 5px 18px rgba(200,184,255,.22);display:flex;align-items:center;justify-content:center;z-index:300;font-weight:800;transition:all .14s';
fab.textContent='＋';fab.onclick=()=>openModal('log-m');
fab.addEventListener('touchstart',()=>{fab.style.transform='scale(.88)'},{ passive:true });
fab.addEventListener('touchend',()=>{fab.style.transform=''},{ passive:true });
document.body.appendChild(fab);

// ══════════════════════════════════════════
// SERVICE WORKER
// ══════════════════════════════════════════
if('serviceWorker' in navigator){
  navigator.serviceWorker.register('./sw.js').then(reg=>{
    console.log('SW registered');
  }).catch(()=>{
    // fallback inline SW
    const swCode=`const C='neet720-v3';const A=['./index.html'];
self.addEventListener('install',e=>{e.waitUntil(caches.open(C).then(c=>c.addAll(A)));self.skipWaiting()});
self.addEventListener('activate',e=>{e.waitUntil(caches.keys().then(ks=>Promise.all(ks.filter(k=>k!==C).map(k=>caches.delete(k)))));self.clients.claim()});
self.addEventListener('fetch',e=>{e.respondWith(caches.match(e.request).then(r=>r||fetch(e.request).catch(()=>caches.match('./index.html'))))});`;
    const blob=new Blob([swCode],{type:'application/javascript'});
    navigator.serviceWorker.register(URL.createObjectURL(blob));
  });
}

// ══════════════════════════════════════════
// INIT
// ══════════════════════════════════════════
renderHeader();
renderToday();
updPomo();
renderPomoHist();
checkNotifPrompt();
